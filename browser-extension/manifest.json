{
  "manifest_version": 3,
  "name": "Helios Browser",
  "version": "0.3.0",
  "description": "Connect one browser tab to the local Helios agent.",
  "permissions": ["activeTab", "scripting", "tabs"],
  "host_permissions": ["http://127.0.0.1:47821/*"],
  "background": { "service_worker": "service-worker.js" },
  "action": { "default_title": "Connect this tab to Helios" }
}
